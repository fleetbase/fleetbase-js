{
    "name": "@fleetbase/sdk",
    "version": "2.0.0-next.0",
    "description": "Official JavaScript and TypeScript SDK for the Fleetbase API",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            },
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.md",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=22.13.0"
    },
    "packageManager": "pnpm@11.24.0",
    "publishConfig": {
        "access": "public",
        "provenance": true,
        "tag": "next"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fleetbase/fleetbase-js.git"
    },
    "homepage": "https://github.com/fleetbase/fleetbase-js#readme",
    "bugs": {
        "url": "https://github.com/fleetbase/fleetbase-js/issues"
    },
    "license": "AGPL-3.0-or-later",
    "author": "Fleetbase",
    "keywords": [
        "fleetbase",
        "logistics",
        "delivery",
        "fleet",
        "sdk",
        "typescript"
    ],
    "scripts": {
        "clean": "node scripts/clean.mjs",
        "build": "pnpm run clean && tsc -p tsconfig.types.json && rollup -c",
        "dev": "rollup -c -w",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:mutation": "stryker run",
        "package:check": "publint && attw --pack . && node scripts/verify-package.mjs",
        "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build && pnpm run package:check",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "release": "changeset publish",
        "publish:ci": "node scripts/publish.mjs",
        "prepublishOnly": "pnpm run verify"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@changesets/cli": "^3.0.1",
        "@eslint/js": "^10.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@stryker-mutator/core": "10.0.0",
        "@stryker-mutator/vitest-runner": "10.0.0",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^10.0.0",
        "globals": "^16.4.0",
        "prettier": "^3.9.0",
        "publint": "^0.3.24",
        "rollup": "^4.63.0",
        "rollup-plugin-dts": "^6.5.1",
        "terser": "^5.46.0",
        "tslib": "^2.8.1",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.68.0",
        "vitest": "^4.1.11"
    }
}
